#!/bin/sh
set -eu

# Delegate the requested cleanup without recursively invoking auto/clean.
lb clean noauto "$@"

# These files are generated by lb config. Removing them makes the next
# auto/config invocation resolve every option from version-controlled inputs.
rm -f config/binary config/bootstrap config/chroot config/common config/source
rm -f build.log nova-live-build-config.txt
